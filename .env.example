# Globrix LLM Basic - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# Required: OpenAI API
# ==============================================
OPENAI_API_KEY=sk-your-openai-api-key

# ==============================================
# Optional: Qdrant Configuration
# ==============================================
QDRANT_COLLECTION_NAME=real_estate_docs

# ==============================================
# Optional: RabbitMQ Credentials
# ==============================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ==============================================
# Optional: PostgreSQL Credentials
# ==============================================
POSTGRES_USER=globrix
POSTGRES_PASSWORD=globrix
POSTGRES_DB=globrix

# ==============================================
# Optional: Supabase (for document storage)
# ==============================================
SUPABASE_URL=
SUPABASE_KEY=

# ==============================================
# Optional: Proxy for OpenAI (if blocked)
# ==============================================
# Format: socks5://user:pass@host:port
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
