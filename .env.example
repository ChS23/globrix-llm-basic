# Globrix LLM Basic - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# Required: OpenRouter API (LLM + Embeddings)
# ==============================================
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# ==============================================
# Required: Core API (apartments search)
# ==============================================
CORE_API_BASE_URL=https://api.globrix.pro
CORE_API_KEY=your-core-api-key

# ==============================================
# Optional: Qdrant Configuration
# ==============================================
QDRANT_COLLECTION_NAME=real_estate_docs

# ==============================================
# Optional: RabbitMQ Credentials
# ==============================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ==============================================
# Optional: PostgreSQL Credentials
# ==============================================
POSTGRES_USER=globrix
POSTGRES_PASSWORD=globrix
POSTGRES_DB=globrix

# ==============================================
# Optional: Supabase (for GenUI deal state)
# ==============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-jwt-key
