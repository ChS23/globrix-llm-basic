{
  "type": "map",
  "name": "Location Map",
  "description": "Карта с отображением объектов",
  "props_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "center": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "additionalProperties": false
      },
      "markers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "price": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "lat",
            "lng",
            "title"
          ],
          "additionalProperties": false
        }
      },
      "zoom": {
        "type": "number"
      }
    },
    "required": [
      "center",
      "markers"
    ],
    "additionalProperties": false,
    "definitions": {}
  }
}