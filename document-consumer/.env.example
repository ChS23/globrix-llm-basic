# Application
APP_NAME=document-consumer
APP_VERSION=0.1.0
DEBUG=true

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=document-consumer-group

# Topics
KAFKA_TOPIC_DOCUMENTS_INGEST=documents.ingest
KAFKA_TOPIC_DOCUMENTS_PROCESSED=documents.processed
KAFKA_TOPIC_QUERY_REQUESTS=query.requests
KAFKA_TOPIC_QUERY_RESPONSES=query.responses

# Vector Store
VECTOR_STORE_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=globrix_docs

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=documents
MINIO_SECURE=false

# LLM (add your API keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
LLM_MODEL=mistral-small-latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_K=5
RETRIEVAL_ALPHA=0.7
